<Window x:Class="DiscordGameOverlay.Views.StreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="直播输出"
        Icon="/DiscordGameOverlay;component/Assets/AppIcon.ico"
        Height="720"
        Width="1280"
        MinHeight="360"
        MinWidth="640"
        Background="#101216">

    <Grid Background="#101216">
        <!-- 游戏画面渲染层。 -->
        <Grid x:Name="VideoLayer">
            <Image x:Name="GamePreviewImage"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"/>

            <StackPanel x:Name="VideoPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="等待游戏画面"
                           FontSize="32"
                           Foreground="#FFE8EAED"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Discord 弹幕会显示在此窗口上方"
                           Margin="0,12,0,0"
                           FontSize="16"
                           Foreground="#FF9AA0A6"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Discord 共享此窗口时，游戏画面与弹幕会被一起捕获。 -->
        <Canvas x:Name="DanmakuCanvas"
                Panel.ZIndex="10"
                Background="Transparent"
                ClipToBounds="True"
                IsHitTestVisible="False"/>

        <!-- Discord 表情触发的互动动画。 -->
        <Canvas x:Name="EffectCanvas"
                Panel.ZIndex="20"
                Background="Transparent"
                ClipToBounds="True"
                IsHitTestVisible="False"/>
    </Grid>

</Window>
