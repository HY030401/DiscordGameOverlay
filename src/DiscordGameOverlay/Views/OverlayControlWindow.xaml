<Window x:Class="DiscordGameOverlay.Views.OverlayControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/DiscordGameOverlay;component/Assets/AppIcon.ico"
        Width="350"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid Background="#AA222222">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>

            <!-- 拖动区域 -->
            <Border Grid.Column="0"
                    Background="Transparent"
                    MouseLeftButtonDown="DragArea_MouseLeftButtonDown">

                <TextBlock Text="⋮⋮ Drag"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Border>

            <!-- 关闭按钮 -->
            <Button Grid.Column="1"
                    Content="×"
                    FontSize="18"
                    Click="CloseButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Margin="3"
                    Content="选择直播画面"
                    Click="SelectCaptureButton_Click"/>

            <Button Grid.Column="1"
                    Margin="3"
                    Content="停止画面"
                    Click="StopCaptureButton_Click"/>

            <Button Grid.Column="2"
                    Margin="3"
                    Content="设置"
                    Click="SettingsButton_Click"/>

            <TextBlock x:Name="CaptureStatusText"
                    Grid.Column="3"
                    Margin="6,0"
                    Text="未选择直播画面"
                    FontSize="12"
                    Foreground="#FFD7DADE"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
